# 复制为 .env 后按需修改（都是可选项）

# 监听地址。放在 nginx 后面时设为 127.0.0.1，不要把端口直接暴露到公网
# HOST=127.0.0.1
# 服务端口
PORT=3000

# 部署在子路径下时设置，比如 https://example.com/watercooler/ 就填 /watercooler。
# 构建前端（pnpm build）和运行服务时都要设置；反向代理需要把这个前缀去掉再转发。
# BASE_PATH=/watercooler
# SQLite 数据库文件路径（默认 ./data/watercooler.db）
# DATABASE_PATH=./data/watercooler.db

# 设置后，注册需要填写邀请码（推荐在公司内网之外部署时开启）
# INVITE_CODE=change-me

# 新用户注册赠送的水滴
STARTING_BALANCE=1000
# 每日签到奖励，0 表示关闭
DAILY_BONUS=100

# 私有模式：未登录用户看不到任何内容（默认关闭，未登录也能浏览市场，类似 Polymarket）
# PRIVATE_MODE=true

# “每日”签到按哪个时区算
APP_TIMEZONE=Asia/Shanghai
